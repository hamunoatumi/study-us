# WebSocketサーバーが別Originの場合だけ指定する
# 未設定時は現在のページのOrigin+/wsへ接続する
VITE_WEBSOCKET_URL=

# 拡張機能ZIPの取得先。同一OriginのViteプロキシを使う場合はこのまま利用する。
VITE_EXTENSION_DOWNLOAD_URL=/extension/download

# 拡張機能ZIPの取得先。同一OriginのViteプロキシを使う場合はこのまま利用する。
VITE_EXTENSION_DOWNLOAD_URL=/extension/download

# ngrok経由でVite開発サーバーを公開する場合（ホスト名のみ、複数はカンマ区切り）
# 通常はルートのPUBLIC_APP_ORIGINから自動設定される
VITE_ALLOWED_HOSTS=

# Vite開発サーバーがWebSocketと拡張機能ダウンロードを転送するサーバー
SERVER_PROXY_TARGET=http://localhost:3000
