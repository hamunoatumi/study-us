# HTTP/WebSocketサーバー
PORT=3000
WEBSOCKET_PATH=/ws

# 複数Originなど、CORS設定を個別に上書きする場合に使用する
ALLOWED_ORIGINS=

# 拡張機能のcontent_scripts.matchesに設定するOrigin
# 未設定の場合はALLOWED_ORIGINSを使用する
EXTENSION_ALLOWED_ORIGINS=

# アプリケーション設定
BANNED_HOSTNAMES=youtube.com
HEARTBEAT_TIMEOUT_MS=30000
DISCONNECT_TIMEOUT_MS=60000
MAX_PARTICIPANTS=100
