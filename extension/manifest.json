{
  "manifest_version": 3,
  "name": "StudyUs Tab Monitor",
  "version": "0.1.0",
  "description": "StudyUs利用中のアクティブタブを検知します。",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
